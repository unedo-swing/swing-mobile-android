# Copy to .env and adjust. Loaded automatically by conftest.py via python-dotenv.
# Android only.

APPIUM_SERVER_URL=http://127.0.0.1:4723

# --- Android ---
DEVICE_NAME=emulator-5554
# PLATFORM_VERSION=14          # optional; leave unset to accept any

# App target: install a build from apps/app.apk (default) OR point at an
# already-installed package. If APP is set it installs that apk.
APP=apps/app.apk
APP_PACKAGE=app.getswing.dev
APP_ACTIVITY=app.getswing.MainActivity

NO_RESET=true
FULL_RESET=false

# Evidence: 1 = generate a PDF per test (default). Set to 0 to disable.
PDF_EVIDENCE=1
# Every PDF is written to reports/. What happens to it after the run:
#   uploaded = deleted once it reached the ClickUp task (default); a file that
#              was not uploaded is kept, so evidence is never lost
#   never    = always keep the file in reports/
#   always   = delete at the end of the run either way
PDF_CLEANUP=uploaded

# --- ClickUp Chat reporting -------------------------------------------------
# One message per run in a ClickUp channel: status, counts, duration, which
# build/device the run used, one row per test case (TC id, name, PASSED/FAILED
# and a link to its PDF), and every failed test with its last step, error
# and evidence. OFF by default — turn it on per run with `pytest --clickup`, or
# for a whole environment (CI) with CLICKUP_REPORT=1. `--no-clickup` opts a
# single run back out.
CLICKUP_REPORT=0
# Personal API token: ClickUp -> avatar -> Settings -> Apps -> API token.
# CLICKUP_TOKEN=pk_xxxxxxxx
# Workspace (team) id — the number in the ClickUp URL: app.clickup.com/<id>/...
# CLICKUP_WORKSPACE_ID=
# Channel id — open the channel, "..." -> Copy link; it is the last id in the URL.
# CLICKUP_CHANNEL_ID=
# CLICKUP_TIMEOUT=15
#
# Sender: ClickUp has no bot account for Chat — the message is always posted by
# whoever owns the token. CLICKUP_BOT_NAME only prefixes it, so the automation
# reads as one in the channel ("🤖 Swing QA Bot · ✅ Swing Android E2E — ...").
# CLICKUP_BOT_NAME=Swing QA Bot
# CLICKUP_BOT_ICON=🤖
#
# Custom message. Unset = the built-in layout (status line, run context, the
# test-case rows, then a block per failed test). Set it to write the whole message yourself; \n is a
# line break, so a multi-line template still fits on one line here.
# Placeholders: {bot} {icon} {title} {status} {counts} {passed} {failed} {error}
#   {skipped} {xfailed} {xpassed} {total} {duration} {date} {time} {datetime}
#   {target} {build} {package} {device} {app_state} {platform} {suite}
#   {link} {link_md} {cases} {cases_count} {failures} {failures_count}
# An unknown placeholder is left as-is in the message so the typo is visible; a
# template that can't render at all falls back to the built-in layout.
# CLICKUP_MESSAGE={bot}{icon} {title} — {status}\n{passed} passed · {failed} failed in {duration} on {device}\n\n{failures}
#
# One extra line under the built-in layout (ignored when CLICKUP_MESSAGE is set):
# CLICKUP_MESSAGE_FOOTER=_posted automatically by the Appium suite_
#
# Evidence PDFs. ClickUp Chat has no attachment endpoint — the only upload route
# is a task's, and the URL it returns (t<workspace>.p.clickup-attachments.com/...)
# is what each test-case row links. A Folder cannot hold files either
# (Space > Folder > List > Task — only the task can), so point the run at a List
# inside your evidence Folder and every run creates its own task there:
#   Folder "QA Automation" -> List "Android E2E runs" -> right-click the list ->
#   Copy link -> the id is the last part of .../v/li/<id>
# CLICKUP_PDF_LIST_ID=901801234567
# Or pile every run's PDFs onto one fixed task instead ("..." -> Copy ID); this
# wins over the list when both are set:
# CLICKUP_PDF_TASK_ID=86abc1234
# With neither set nothing is uploaded and the rows show plain filenames.
# Which PDFs: all (default) = every test's evidence, so each row has a link;
# failed = only the failed tests' evidence; off = upload nothing.
# CLICKUP_PDF_SCOPE=all
# CLICKUP_PDF_LIMIT=30          # most files one run uploads
# CLICKUP_PDF_MAX_MB=25         # bigger files are skipped (ClickUp allows 1GB)
# CLICKUP_UPLOAD_TIMEOUT=120    # seconds per file
# CLICKUP_MAX_CASES=30          # most test-case rows one message lists
# Only if the account needs a different endpoint than the v3 Chat default:
# CLICKUP_API_BASE=https://api.clickup.com/api
# CLICKUP_MESSAGES_PATH=/v3/workspaces/{workspace}/chat/channels/{channel}/messages

# --- Test data ---
# Shared mobile test-data workbook. Each feature reads its own worksheet from it
# (e.g. DrivingRangeData reads the DRIVING_RANGE_SHEET tab). Path is relative to
# where you run pytest.
TEST_DATA_MOBILE=data/test_data_swing_mobile.xlsx
DRIVING_RANGE_SHEET=Driving_Range

# --- APIs -------------------------------------------------------------------
# utils/api_client.py talks to any backend a test needs. One env prefix per
# API, always the same seven keys — ApiClient.from_env("<PREFIX>") reads them.
# {name} placeholders are filled from the keyword arguments of the call.
#
#   <PREFIX>_URL          base url or full endpoint (required)
#   <PREFIX>_METHOD       GET (default) / POST / PUT / PATCH / DELETE
#   <PREFIX>_HEADERS      {"x-api-key": "..."}      JSON object
#   <PREFIX>_PARAMS       {"country": "62"}         JSON object -> query string
#   <PREFIX>_BODY         {"phone": "{phone}"}      JSON object -> request body
#   <PREFIX>_TIMEOUT      seconds per request (10)
#   <PREFIX>_RETRIES      attempts before giving up (1)
#   <PREFIX>_RETRY_DELAY  seconds between attempts (3)
#
# The Swing backend itself has a ready-made client — ApiClient.swing() — that
# carries the headers the app sends. These are its dev defaults; override only
# what differs (e.g. point SWING_API_URL at another environment).
# SWING_API_URL=https://api-dev.getswing.cloud
# SWING_API_KEY=ZGV2LXB1YmxpYy1hcGkta2V5
# SWING_DEVICE=android-5.1.0-DEV.20260812+1786530371
# SWING_DEVICE_ID=android_Google_sdk_gphone64_arm64_622e541f1ab5c539
# SWING_TIMEZONE=WIB
# SWING_SOURCE=MOBILE_PLAYERS
# SWING_GEO_COUNTRY=ID
# SWING_FILTER_COUNTRY=ID
# X-Package-Name reuses APP_PACKAGE above.

# OTP: the login tests call POST /players/api/v1/auth/otp/request and read the
# code out of the response, so nobody has to read a phone. An OTP cell in the
# sheet still wins, except when it says "api"/"auto", which forces the call
# even if a bypass code exists; a blank cell falls back to asking at the
# terminal when the environment answers without a code.
# SWING_DIAL_CODE=+62           # only used when the dial code can't be read
#                               # off the login screen ("ID (+62)" -> "+62")
# SWING_SPAM_TOKEN=skip_swing_anti_spam
# SWING_OTP_FIELD=data.otp      # dotted path; unset = find the otp/code key
# SWING_OTP_REQUEST_PATH=/players/api/v1/auth/otp/request

# Another API, the seven keys above — used from a test as
#   ApiClient.from_env("BOOKING_API").get("/v1/bookings/{id}", id=booking_id)
# BOOKING_API_URL=https://api-dev.getswing.cloud
# BOOKING_API_HEADERS={"Authorization": "Bearer ..."}
