# Copy to .env.prod and adjust. Loaded ON TOP OF .env when you run with
# --prod (or PROD=1), so only the values that differ from .env belong here.
#
#     pytest --prod tests/test_login.py -s
#     PROD=1 pytest tests/test_login.py -s
#
# Target: the production Swing app installed from the Play Store, NOT the
# bundled apps/app.apk dev build.

# --- App target -------------------------------------------------------------
# APP=none means "install nothing, drive the build already on the device".
# This is what makes a Play Store install testable: there is no APK to hand
# Appium, and installing one would replace the very build under test.
# Leave this as none.
APP=none

# The production package + launcher activity. These are NOT the dev values
# (dev is app.getswing.dev). Find the real ones on a device that has the Play
# Store build installed:
#
#     adb shell pm list packages | grep -i swing
#     adb shell cmd package resolve-activity --brief <package> | tail -1
#
APP_PACKAGE=app.getswing
APP_ACTIVITY=app.getswing.MainActivity

# --- Device -----------------------------------------------------------------
# Prod testing usually means a real handset (the Play Store isn't on a plain
# AVD). Get the serial from `adb devices`.
# DEVICE_NAME=<your-device-serial>

# --- Reset behaviour --------------------------------------------------------
# Keep the app installed and signed in. FULL_RESET would uninstall the Play
# Store build with no APK to restore it — leave it false.
NO_RESET=true
FULL_RESET=false

# --- Test data --------------------------------------------------------------
# Prod has none of the dev fixtures ("[Testing] Single Bay Driving Range",
# "Test Test Golf", ...), so any test that names a venue, price or booking id
# needs its own workbook/sheet here.
# TEST_DATA_MOBILE=data/test_data_swing_prod.xlsx
# DRIVING_RANGE_SHEET=Driving_Range_Prod

# ---------------------------------------------------------------------------
# WARNING — this is the live app.
#   * Bookings and payments are real. Do not run the booking/payment suites.
#   * --app-state clear signs the account out; logging back in sends a real OTP
#     to a real phone, which no test can complete on its own.
#   * --app-state reinstall is refused while APP=none (nothing to reinstall
#     from). Reinstall by hand from the Play Store if you ever need to.
# Realistic prod scope is read-only smoke: app launches, Home renders, Explore
# lists venues, Account renders.
# ---------------------------------------------------------------------------
